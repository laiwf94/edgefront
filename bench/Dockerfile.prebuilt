# syntax=docker/dockerfile:1
# The benchmark images from binaries built on the host, for CI, where the
# host's cargo cache makes this much faster than building in a container.
# The context is a directory holding only `edgefront` and `edgefront-bench`
# (release builds for the image's architecture, linked against a glibc no
# newer than Debian 13's). Same stages and tags as bench/Dockerfile.
FROM gcr.io/distroless/cc-debian13:nonroot AS harness
COPY edgefront-bench /edgefront-bench
USER nonroot:nonroot
ENTRYPOINT ["/edgefront-bench"]

FROM gcr.io/distroless/cc-debian13:nonroot AS edgefront
COPY edgefront /edgefront
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/edgefront"]
CMD ["--config", "/etc/edgefront/edgefront.toml"]
