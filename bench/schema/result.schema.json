{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laiwf94/edgefront/bench/schema/result.schema.json",
  "title": "edgefront-bench result",
  "description": "One benchmark scenario run against one target, as written by edgefront-bench run. Latencies are milliseconds of response time from each request's scheduled send time.",
  "$defs": {
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p50_ms",
        "p90_ms",
        "p99_ms",
        "p999_ms",
        "max_ms",
        "mean_ms"
      ],
      "properties": {
        "p50_ms": {
          "type": "number",
          "minimum": 0
        },
        "p90_ms": {
          "type": "number",
          "minimum": 0
        },
        "p99_ms": {
          "type": "number",
          "minimum": 0
        },
        "p999_ms": {
          "type": "number",
          "minimum": 0
        },
        "max_ms": {
          "type": "number",
          "minimum": 0
        },
        "mean_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "id",
        "size_bytes"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run",
    "track",
    "started_at",
    "command",
    "scenario",
    "target",
    "machine",
    "measured",
    "phases",
    "resources"
  ],
  "properties": {
    "schema": {
      "const": "edgefront-bench/result/v1"
    },
    "run": {
      "type": "string",
      "minLength": 1
    },
    "track": {
      "enum": [
        "cache",
        "proxy",
        "limiter"
      ]
    },
    "started_at": {
      "type": "string",
      "minLength": 20,
      "description": "RFC 3339 in UTC, such as 2026-11-20T10:00:00Z."
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "protocol",
        "connections",
        "seed",
        "warmup_secs",
        "measured_secs",
        "rate",
        "hit_ratio_target",
        "working_set_bytes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "protocol": {
          "enum": [
            "http1",
            "http2"
          ]
        },
        "connections": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "warmup_secs": {
          "type": "number",
          "minimum": 0
        },
        "measured_secs": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rate": {
          "type": "number",
          "minimum": 0
        },
        "hit_ratio_target": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "working_set_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "tls_server_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "product",
        "version",
        "kind",
        "images",
        "image_size_bytes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "cache",
            "proxy"
          ]
        },
        "images": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/image"
          }
        },
        "image_size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "cpus",
        "memory_bytes",
        "kernel",
        "arch",
        "runtime",
        "target_cpus",
        "origin_cpus",
        "loadgen_cpus"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "cpus": {
          "type": "integer",
          "minimum": 1
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "kernel": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "target_cpus": {
          "type": "string",
          "minLength": 1
        },
        "origin_cpus": {
          "type": "string",
          "minLength": 1
        },
        "loadgen_cpus": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "measured": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheduled",
        "completed",
        "errors",
        "status_classes",
        "body_bytes",
        "throughput_rps",
        "origin_requests",
        "hit_ratio",
        "latency",
        "service_latency"
      ],
      "properties": {
        "scheduled": {
          "type": "integer",
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connect",
            "timeout",
            "other"
          ],
          "properties": {
            "connect": {
              "type": "integer",
              "minimum": 0
            },
            "timeout": {
              "type": "integer",
              "minimum": 0
            },
            "other": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "status_classes": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "body_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "throughput_rps": {
          "type": "number",
          "minimum": 0
        },
        "origin_requests": {
          "type": "integer",
          "minimum": 0
        },
        "hit_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "latency": {
          "$ref": "#/$defs/latency"
        },
        "service_latency": {
          "$ref": "#/$defs/latency"
        }
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "warmup",
          "rate",
          "duration_secs",
          "scheduled",
          "completed",
          "errors",
          "throughput_rps",
          "latency"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "warmup": {
            "type": "boolean"
          },
          "rate": {
            "type": "number",
            "minimum": 0
          },
          "duration_secs": {
            "type": "number",
            "minimum": 0
          },
          "scheduled": {
            "type": "integer",
            "minimum": 0
          },
          "completed": {
            "type": "integer",
            "minimum": 0
          },
          "errors": {
            "type": "integer",
            "minimum": 0
          },
          "throughput_rps": {
            "type": "number",
            "minimum": 0
          },
          "latency": {
            "$ref": "#/$defs/latency"
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "peak_rss_bytes",
        "peak_memory_bytes",
        "cpu_seconds",
        "cpu_cores",
        "cpuset"
      ],
      "properties": {
        "peak_rss_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "peak_memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_seconds": {
          "type": "number",
          "minimum": 0
        },
        "cpu_cores": {
          "type": "number",
          "minimum": 0
        },
        "cpuset": {
          "type": "string"
        }
      }
    },
    "extra": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    }
  }
}
