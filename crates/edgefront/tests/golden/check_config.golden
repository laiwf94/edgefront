$ {program} --check-config {dir}/good.toml
exit: 0
stdout:
{dir}/good.toml: ok
stderr:

$ CACHET_ADMIN_TOKEN=<5 bytes> {program} --check-config {dir}/good.toml
exit: 0
stdout:
{dir}/good.toml: ok
stderr:

$ {program} --check-config {dir}/unknown.toml
exit: 2
